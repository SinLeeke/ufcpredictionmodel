# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# DATOS Y MODELOS — no se versionan porque son DERIVADOS, no fuente.
# Son ~35 MB, cambian en cada corrida, y quien clone el repo los reconstruye
# con los comandos del README (sección "Construir la base").
# ---------------------------------------------------------------------------
data/
models/
outputs/

# Carteleras propias. El CSV de ejemplo SÍ se versiona, para que se entienda
# el formato sin tener que correr nada.
cards/*
!cards/ejemplo_con_cuotas.csv

# Backups locales de modelos/datasets viejos (una subcarpeta por fecha)
backups/

# Copias comprimidas de la base o del proyecto: son datos derivados (ver arriba) y
# pesan megas en cada clon. Para pasarle la base a otro equipo, mejor un adjunto de
# un Release de GitHub o una carpeta compartida.
*.rar
*.zip
*.7z

# PDF del manual: se regenera, no es fuente
MANUAL.pdf
MINIMANUAL.pdf

# ---------------------------------------------------------------------------
# SECRETOS Y CONFIG LOCAL — lo importante de este archivo.
# Nada de esto debe salir del PC.
# ---------------------------------------------------------------------------
# Credenciales de Kaggle (kagglehub las lee de ~/.kaggle, pero por si acaso
# alguien copia el kaggle.json a la carpeta del proyecto)
kaggle.json
.kaggle/

# Variables de entorno con tokens o keys
.env
.env.*
*.pem
*.key
secrets.json
credentials.json

# Config de asistentes de código (permisos y preferencias personales)
.claude/
.cursor/
.aider*
# El contexto para asistentes se queda en local: es una nota de trabajo, no
# documentación del proyecto. Lo que vale de ahí (qué se midió y qué falló)
# vive en README.md, que sí se versiona.
CLAUDE.md

# Editores / IDE
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# Sistema
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
