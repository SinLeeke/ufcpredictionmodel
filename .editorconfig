# Lo mismo en cualquier editor: UTF-8 (el código y los comentarios van en
# español, con tildes), fin de línea LF y la sangría de cada lenguaje.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,cjs,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
