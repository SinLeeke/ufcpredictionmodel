# Copia este archivo como .env (en la raíz del proyecto) y completa lo que uses.
# El .env NO se versiona: .gitignore lo excluye. Este ejemplo sí, vacío.

# The Odds API (https://the-odds-api.com). Plan gratis: 500 créditos al mes.
# Sin clave, la fuente queda desactivada con un aviso y el resto sigue igual.
ODDS_API_KEY=

# Región de casas de The Odds API: us, us2, uk, eu o au. Cada región extra
# cuesta un crédito más por llamada, así que se pide una sola.
ODDS_API_REGION=us

# 1 = mercado en vivo simulado (fuente "simulada" y un evento falso en curso),
# para probar la sección "Mercado en vivo" sin una pelea real. Vacío = apagado.
UFC_MERCADO_SIMULADO=
